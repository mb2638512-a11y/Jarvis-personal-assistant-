# Never commit real credentials. Use a local .env file or deployment secrets.
JARVIS_API_KEY=
JARVIS_BASE_URL=https://api.openai.com/v1
JARVIS_MODEL=
JARVIS_REQUEST_TIMEOUT_SECONDS=30

# OAuth-first social account connection. This is your self-hosted Postiz web app,
# where users authorize accounts using each provider's official OAuth consent flow.
# Configure the official provider app credentials on the Postiz server as required.
# Do not put provider tokens, client secrets, or workspace admin credentials in Jarvis clients.
JARVIS_POSTIZ_APP_URL=https://social.example.com

# Legacy public API adapter (optional; not used by the OAuth-first social hub UI).
JARVIS_POSTIZ_API_KEY=
JARVIS_POSTIZ_BASE_URL=https://api.postiz.com/public/v1
JARVIS_POSTIZ_GATEWAY_TOKEN=
JARVIS_POSTIZ_TIMEOUT_SECONDS=20
